{
  "name": "soundtrack-timeline-monorepo",
  "version": "2.0.0",
  "description": "Soundtrack Timeline - Plataforma Editorial de Analítica Musical y Artefactos Gráficos",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=@soundtrack-timeline/shared \u0026\u0026 npm run build --workspace=backend \u0026\u0026 npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": "\u003e=22.0.0",
    "npm": "\u003e=10.0.0"
  }
}
